# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets — never commit real keys. The bare `.env` pattern matches .env at ANY
# depth (root and frontend/.env). Also cover local overrides.
.env
.env.*
!.env.example

# SQLite database file (regenerated by seed.py)
*.db

# Chroma vector store (Phase 3) — rebuildable from backend/knowledge/*.md
chroma_db/

# Node / frontend build artifacts (also ignored in frontend/.gitignore)
node_modules/
dist/

# Claude Code local settings (keep CLAUDE.md tracked, ignore the folder)
.claude/
