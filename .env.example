# Copy this file to `.env` and fill in real values as you reach each phase.
# Phase 1 needs NONE of these — they are placeholders so the structure is ready.

# --- Docker host ports (override if these clash on your machine) ---
# Only the HOST side changes; containers stay on 8000/5173 internally. The API URL,
# CORS, and Stripe redirect URLs all derive from these in docker-compose.yml.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Phase 2: Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Phase 4: AI chat assistant ---
# We will pick ONE provider at Phase 4 (decision deferred).
# Anthropic Claude = strongest tool calling (the API the project set out to learn).
ANTHROPIC_API_KEY=
# Groq = free + fast, OpenAI-compatible, also supports tool calling.
GROQ_API_KEY=
